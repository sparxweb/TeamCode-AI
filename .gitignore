# ============================================================================
# TeamCode AI — Universal .gitignore
# ============================================================================

# Environment Variables & Secrets (CRITICAL: Never commit real secrets)
.env
.env.*
!.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Python Environments & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
teamcode_backend.egg-info/
backend/teamcode_backend.egg-info/
.installed.cfg
*.egg

# Testing & Quality Tool Caches
.pytest_cache/
backend/.pytest_cache/
.coverage
coverage/
htmlcov/
.oxlintrc.cache

# Node / Frontend Artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/dist-ssr/
.next/
.vite/
frontend/.vite/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# User Data & Local History (Exclude runtime review database)
backend/data/*.json
backend/data/history.json
!backend/data/.gitkeep

# Temporary / Scratch & Development Scripts
scratch/
tmp/
temp/
*.tmp
*.temp

# Log Files
*.log
logs/
backend/*.log

# IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
