# ============================================================================
# TeamCode AI — Environment Configuration Template
# ============================================================================
# Copy this file to .env and provide your secret API keys.
# NEVER commit your actual .env file with real secrets to version control.

# Groq LLM API Configuration (Required for AI contextual review and auto-fix)
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection (Defaults to openai/gpt-oss-120b)
# Fallbacks: openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# HindSight Engineering Team Memory Configuration (Optional but recommended)
# Obtain your API key at: https://hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=teamcode-ai

# Optional Integrations / Placeholders (Not required for default operation)
STRIPE_API_KEY=
DATABASE_URL=
JWT_SECRET=

